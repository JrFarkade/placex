# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default – great for local dev)
DATABASE_URL=sqlite+aiosqlite:///./mcq_service.db

# PostgreSQL (uncomment and fill in for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mcq_db

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Quiz Engine ───────────────────────────────────────────────────────────────
# How many AI questions to generate per batch when the bank runs dry
AI_GENERATION_BATCH_SIZE=10
# Consecutive correct answers required to mark a question as 'mastered'
MASTERY_THRESHOLD=2
# Fraction of quiz slots reserved for spaced-repetition "learning" questions
REVIEW_SLOT_RATIO=0.35
