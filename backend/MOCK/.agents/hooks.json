{
  "placex-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/safety_gate.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
